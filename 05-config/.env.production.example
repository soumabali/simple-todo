# FlowBoard — Production Environment Reference
#
# This file documents every environment variable/secrets required to deploy
# FlowBoard to Cloudflare Workers + Neon Postgres. It is a REFERENCE ONLY —
# do NOT commit real values here. Real values live in:
#   - GitHub Actions secrets (CI/CD)
#   - Wrangler secrets / vars (Worker runtime)
#   - ~/.hermes/.env (local credentials, already populated)
#
# Values marked [IN .env] are already present in ~/.hermes/.env.

# ===================== Neon Postgres =====================
# Pooled connection strings. Production branch = `production`, staging = `develop`.
# [IN .env] — already present
DATABASE_URL_UNPOOLED=            # for drizzle-kit migrations (unpooled, port 5432)
NEON_PRODUCTION_URL=              # [IN .env] pooled, branch `production`
NEON_DEVELOP_URL=                 # [IN .env] pooled, branch `develop`
NEON_API_KEY=                     # [IN .env] for `neon deploy` in CI

# ===================== Auth (better-auth, self-hosted) =====================
# 32+ char random secret. GENERATE ONCE: openssl rand -base64 48
BETTER_AUTH_SECRET=               # [MISSING — must be generated & set as GitHub secret]
BETTER_AUTH_URL=https://todo.nexigo.my.id   # base URL (Worker var, NOT secret)

# ===================== Web Push (VAPID) =====================
# Generated once: npx @pushforge/builder vapid
VAPID_PUBLIC_KEY=                 # [IN .env] safe to publish (Worker var)
VAPID_PRIVATE_KEY=                # [IN .env] JWK JSON string — SECRET (Wrangler secret)
VAPID_SUBJECT=mailto:admin@nexigo.my.id    # admin contact (Worker var)

# ===================== Cloudflare =====================
CLOUDFLARE_ACCOUNT_ID=            # [IN .env] = 81e5bd15a7810cb281f887efa5f0f4d0
CLOUDFLARE_API_TOKEN=             # [IN .env] — NOTE: current token is DNS-scoped only;
                                  #   deploy needs a NEW token with "Workers Scripts: Edit"
                                  #   (see deploy-guide.md §2)

# ===================== GitHub =====================
# Fine-grained PAT (admin over soumabali/simple-todo) — [IN .env] as
# GITHUB_FINE_GRAINED_TOKENS. NOTE: it lacks Actions "Secrets" permission,
# so secrets must be set in the GitHub UI (see deploy-guide.md §4).

# ===================== Seed admin (first-run only) =====================
SEED_ADMIN_EMAIL=admin@flowboard.local
SEED_ADMIN_PASSWORD=              # change before first prod run
SEED_ADMIN_NAME=Admin
