# --- Database ---
# Local dev (Docker Postgres on port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/simple_todo

# --- Better Auth (self-hosted per PRD §6.3 Option B) ---
# Generate a real secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32+char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Web Push (VAPID) ---
# Generate once: npx @pushforge/builder vapid
# NOTE: rotating these keys kills every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Seed (first admin account) ---
SEED_ADMIN_EMAIL=admin@flowboard.local
SEED_ADMIN_PASSWORD=              # REQUIRED — no default; `npm run db:seed` refuses to run without it
SEED_ADMIN_NAME=Admin

# --- Deployment (CI only — set as GitHub Secrets / Wrangler secrets) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# NEON_API_KEY=
# NEON_PRODUCTION_URL=
# NEON_DEVELOP_URL=
# NEON_AUTH_BASE_URL=       (only if adopting Managed Better Auth)
# NEON_AUTH_COOKIE_SECRET=  (only if adopting Managed Better Auth)
